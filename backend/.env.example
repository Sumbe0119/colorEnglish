# PostgreSQL холболт
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/colorenglish?schema=public"

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# JWT
JWT_ACCESS_SECRET="change-this-to-a-long-random-string-access"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS=30

# AI (Speaking / Writing модулиудад ашиглана — Anthropic API)
ANTHROPIC_API_KEY=""

# QPay Merchant API v2
# username = client_id, password = client_secret (QPay-ээс авна)
QPAY_BASE_URL="https://merchant.qpay.mn"
QPAY_USERNAME=""
QPAY_PASSWORD=""
QPAY_INVOICE_CODE=""
# Optional — Create simple invoice sender_branch_code
QPAY_BRANCH_CODE=""
# Публик backend URL (ngrok / production). Callback:
# {BACKEND_PUBLIC_URL}/api/subscriptions/payments/qpay-callback?payment_id=...
BACKEND_PUBLIC_URL="http://localhost:4000"
