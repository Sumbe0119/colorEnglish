# backend/.env.prod — production (docker + app)

# Docker Compose
COMPOSE_PROJECT_NAME=colorenglish-prod
POSTGRES_USER=colorenglish
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=colorenglish
POSTGRES_PORT=5433

# App → PostgreSQL
DATABASE_URL="postgresql://colorenglish:change-me-strong-password@localhost:5433/colorenglish?schema=public"

# Server
PORT=4000
NODE_ENV=production
FRONTEND_URL="http://colorenglish.mn"

# JWT
JWT_ACCESS_SECRET="change-this-to-a-long-random-string-access"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS=30

# AI
ANTHROPIC_API_KEY=""

# QPay
QPAY_BASE_URL="https://merchant.qpay.mn"
QPAY_USERNAME="MYBOX"
QPAY_PASSWORD="WOKXlmKp"
QPAY_INVOICE_CODE="MYBOX_INVOICE"
QPAY_BRANCH_CODE=""
BACKEND_PUBLIC_URL="http://colorenglish.mn/api"
